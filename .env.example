PORT=8080
GITHUB_OWNER=cujarrett
GITHUB_REPO=homelab-workspaces
# Token comes from ~/.secrets as GITHUB_TOKEN - no need to set here locally
# In cluster: injected via secretRef -> envFrom from launchpad-secrets K8s Secret

# Entra auth - set these for production; set ENTRA_AUTH_DISABLED=true for local dev
ENTRA_TENANT_ID=PLACEHOLDER_TENANT_ID
ENTRA_API_CLIENT_ID=PLACEHOLDER_API_CLIENT_ID
# ENTRA_AUTH_DISABLED=true
